<Window x:Class="WarehouseManagement.Views.ProductModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarehouseManagement"
        mc:Ignorable="d"
        Title="Редактирование товара" 
        Height="730" Width="560" 
        WindowStartupLocation="CenterScreen">

    <Window.CommandBindings>
        <CommandBinding Command="local:WindowCommands.OrgOk" Executed="BtnSave_Click"/>
        <CommandBinding Command="local:WindowCommands.OrgCancel" Executed="BtnCancel_Click"/>
    </Window.CommandBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <TextBlock Text="Артикул *" FontWeight="Bold" Margin="0 12 0 3"/>
            <TextBox x:Name="txtArticle" Height="28"/>

            <TextBlock Text="Наименование *" FontWeight="Bold" Margin="0 12 0 3"/>
            <TextBox x:Name="txtName" Height="28"/>

            <TextBlock Text="Единица" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox x:Name="txtUnit" Height="28" Text=""/>

            <TextBlock Text="Цена *" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox x:Name="txtPrice" Height="28"/>

            <TextBlock Text="Скидка %" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox x:Name="txtDiscount" Height="28" Text="0"/>

            <TextBlock Text="Категория" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox x:Name="txtCategoryName" Height="28" />

            <TextBlock Text="Производитель" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox x:Name="txtManufacturerName" Height="28" />

            <TextBlock Text="Поставщик" FontWeight="Bold" Margin="0 12 0 3"/>
            <TextBox x:Name="txtSupplierName" Height="28"/>

            <TextBlock Text="Путь к фото" FontWeight="Bold" Margin="0 12 0 3"/>
            <TextBox x:Name="txtPhotoPath" Height="28"/>

            <TextBlock Text="Описание товара" FontWeight="Bold" Margin="0 12 0 3" />
            <TextBox x:Name="txtDescription" Height="28"/>

            <TextBlock Text="Количество *" FontWeight="Bold" Margin="0 12 0 3" />
            <TextBox x:Name="txtQuantity" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 0 0">
            <Button Content="Сохранить" Width="140" Height="40" 
                    Command="local:WindowCommands.OrgOk" FontWeight="Bold" Margin="0 0 10 0"/>
            <Button Content="Отмена" Width="120" Height="40" 
                    Command="local:WindowCommands.OrgCancel"/>
        </StackPanel>
    </Grid>
</Window>